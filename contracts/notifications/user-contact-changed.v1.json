{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kargo.ru/contracts/notifications/user-contact-changed.v1.json",
  "title": "UserContactChanged.v1",
  "description": "Событие смены контактов получателя (user.contact_changed): конверт и payload (FR-NTF-231, ЧТЗ 8.3). Единственный контракт с персональными данными: публикуется только в поток contacts, не логируется.",
  "x-event-type": "user.contact_changed",
  "x-schema-version": "v1",
  "x-stream": "events.contacts",
  "type": "object",
  "required": [
    "message_id",
    "event_type",
    "schema_version",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "payload"
  ],
  "additionalProperties": true,
  "properties": {
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "user.contact_changed"
    },
    "schema_version": {
      "const": "v1"
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9._-]{8,128}$"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "aggregate_type": {
      "const": "user"
    },
    "aggregate_id": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "event_id",
        "user_id",
        "email",
        "locale",
        "occurred_at"
      ],
      "additionalProperties": true,
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "user_id": {
          "type": "integer",
          "minimum": 1
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 255
        },
        "locale": {
          "type": "string",
          "minLength": 2,
          "maxLength": 16
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
