APP_NAME="Сервис оповещений"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8081

# Время и локали приложения берутся из конфигурации
APP_TIMEZONE=Europe/Moscow
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

# Логи — структурированные записи в stderr без персональных данных
LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Собственная база сервиса (FR-NTF-212, FR-NTF-213): отдельная база и роль,
# доступа к базе монолита у роли нет.
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=notifications
DB_USERNAME=notifications
DB_PASSWORD=notifications

# Кэш, сессии и очередь в сервисе не ведутся: отправку повторяет поллер, а не очередь
CACHE_STORE=array
# Явные имена, чтобы смена умолчаний Laravel 13 не переименовала ключи кэша и Redis.
CACHE_PREFIX=servis-opoveshhenii-cache-
REDIS_PREFIX=servis-opoveshhenii-database-
SESSION_DRIVER=array
SESSION_COOKIE=servis-opoveshhenii-session
QUEUE_CONNECTION=sync

# Redis Streams (FR-NTF-206, FR-OPS-211); predis не требует php-расширения redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Почта: локальный перехватчик Mailpit, реальных адресов нет
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@courier.test"
MAIL_FROM_NAME="${APP_NAME}"

# Транспорт событий, потоки, consumer group и параметры потребления (FR-OPS-211)
NOTIFICATIONS_TRANSPORT=redis
NOTIFICATIONS_STREAM_PREFIX=
NOTIFICATIONS_STREAM_ORDERS=events.orders
NOTIFICATIONS_STREAM_NOTIFICATIONS=events.notifications
NOTIFICATIONS_STREAM_CONTACTS=events.contacts
NOTIFICATIONS_CONSUMER_GROUP=notifications-service
NOTIFICATIONS_CONSUMER_NAME=notifications-service-1
# У потока контактов свой получатель в группе (FR-NTF-231)
NOTIFICATIONS_CONTACTS_CONSUMER_NAME=notifications-service-1-contacts
NOTIFICATIONS_CONSUME_BATCH_SIZE=50
NOTIFICATIONS_PENDING_IDLE_SECONDS=60
NOTIFICATIONS_BLOCK_MILLISECONDS=1000
NOTIFICATIONS_RECLAIM_COUNT=100

# Опциональный брокер RabbitMQ (FR-NTF-541…552, ЧТЗ 8.5). Адаптер:
# подключён, значения безопасны для разработки: реальных адресов и секретов
# в репозитории нет (FR-NTF-549). Переключение — NOTIFICATIONS_TRANSPORT=rabbitmq.
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_HEARTBEAT=30
RABBITMQ_TIMEOUT_SECONDS=5
RABBITMQ_PREFETCH=50
RABBITMQ_MESSAGE_TTL_SECONDS=300
RABBITMQ_MAX_ATTEMPTS=5
# Топология: общий exchange, очередь сервиса и пара DLX/DLQ (FR-NTF-548).
RABBITMQ_EXCHANGE=events
RABBITMQ_QUEUE=notifications.events
RABBITMQ_DLX_EXCHANGE=events.dlx
RABBITMQ_DLQ_QUEUE=notifications.dlq

# Политика каналов и тексты (FR-NTF-241…247): выключенный канал отбрасывается.
NOTIFICATIONS_ENABLED_CHANNELS=email,push
NOTIFICATIONS_SUPPORTED_LOCALES=ru
NOTIFICATIONS_LOCALE_FALLBACK=ru
NOTIFICATIONS_TRACKING_URL=http://localhost:8000/track/{tracking_code}

# Общий каталог JSON Schema контрактов (FR-NTF-221) монтируется только для чтения
NOTIFICATIONS_SCHEMA_PATH=/var/www/html/contracts/notifications
NOTIFICATIONS_SCHEMA_DIALECT=https://json-schema.org/draft/2020-12/schema
NOTIFICATIONS_SCHEMA_VERSION=v1

# Служебный токен API (FR-OPS-206, FR-OPS-211). Значение по умолчанию допустимо
# только для локальной разработки и переопределяется переменной окружения.
NOTIFICATIONS_API_TOKEN=dev-notifications-token
NOTIFICATIONS_API_RATE_LIMIT_ATTEMPTS=60
NOTIFICATIONS_API_RATE_LIMIT_WINDOW_SECONDS=60
NOTIFICATIONS_API_PAGE_LIMIT=50
NOTIFICATIONS_API_MAX_PAGE_LIMIT=200
NOTIFICATIONS_API_PROBLEM_TYPE_BASE=https://notifications.local/problems

# Процессы: пауза потребителя и параметры поллера отправки (FR-NTF-172)
NOTIFICATIONS_CONSUMER_SLEEP_SECONDS=1
NOTIFICATIONS_SENDER_POLL_INTERVAL_SECONDS=5
NOTIFICATIONS_SENDER_BATCH_SIZE=50
NOTIFICATIONS_MAX_ATTEMPTS=5
NOTIFICATIONS_BACKOFF_SECONDS=10,30,60,120,300
# Разброс паузы (доля от базовой) и предел сообщения об ошибке в журнале попыток.
NOTIFICATIONS_BACKOFF_JITTER_RATIO=0.2
NOTIFICATIONS_ATTEMPT_MESSAGE_LIMIT=200
# Таймаут одной попытки отправки; то же значение получает SMTP-транспорт (FR-OPS-205)
NOTIFICATIONS_SEND_TIMEOUT_SECONDS=30
MAIL_TIMEOUT=30
# Пауза, после которой брошенное уведомление снова доступно к отправке.
# Значение обязано быть больше времени обработки пачки (FR-OPS-205)
NOTIFICATIONS_SENDER_RETRY_AFTER_SECONDS=1800

# Таймауты подключения к базе и Redis (FR-OPS-205)
DB_CONNECT_TIMEOUT=5
REDIS_CONNECT_TIMEOUT=5
REDIS_READ_TIMEOUT=60

# Сроки хранения журнала, попыток, push-журнала, Inbox и ключей дедупликации,
# расписание очистки и режим push-провайдера (ЧТЗ 7, п. 8, FR-NTF-267)
NOTIFICATIONS_RETENTION_DAYS=90
NOTIFICATIONS_ATTEMPT_RETENTION_DAYS=90
NOTIFICATIONS_PUSH_RETENTION_DAYS=30
NOTIFICATIONS_INBOX_RETENTION_DAYS=30
NOTIFICATIONS_DEDUP_RETENTION_DAYS=30
NOTIFICATIONS_PURGE_CRON="30 3 * * *"

# Очередь необработанных, токены устройств и метрики M13 (FR-NTF-508,
# FR-NTF-530, FR-OPS-501…508, ЧТЗ 8.5): сроки, лимиты порций и границы
# гистограммы задаются только окружением.
NOTIFICATIONS_DLQ_RETENTION_DAYS=90
NOTIFICATIONS_DLQ_PAGE_LIMIT=50
NOTIFICATIONS_DLQ_MAX_PAGE_LIMIT=200
NOTIFICATIONS_DEVICE_TOKEN_RETENTION_DAYS=30
NOTIFICATIONS_METRICS_ENABLED=true
NOTIFICATIONS_METRICS_SNAPSHOT_TTL_SECONDS=30
NOTIFICATIONS_METRICS_HISTOGRAM_BUCKETS=0.1,0.5,1,2,5,10
# Снимок метрик общий для процессов отправки, расписания и HTTP, поэтому
# хранится в Redis; частота задачи расписания задаётся cron-выражением.
NOTIFICATIONS_METRICS_SNAPSHOT_CRON="* * * * *"
NOTIFICATIONS_METRICS_CACHE_STORE=redis
NOTIFICATIONS_METRICS_CACHE_PREFIX=notifications:metrics:

# Push-провайдер M13 (FR-NTF-521…524): по умолчанию fake. Реальный FCM
# включается NOTIFICATIONS_PUSH_PROVIDER=fcm, креды задаются только окружением
# и в репозитории не хранятся (FR-NTF-522).
NOTIFICATIONS_PUSH_PROVIDER=fake
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=
FCM_TIMEOUT_SECONDS=10
FCM_RETRY_TIMES=2
FCM_RETRY_SLEEP_MS=200

# Telegram (FR-NTF-431…443, ЧТЗ 8.5). Токен бота и секрет вебхука задаются
# только окружением: безопасные пустые значения, реальных секретов в репозитории нет.
# Канал выключен по умолчанию: `NOTIFICATIONS_ENABLED_CHANNELS=email,push,telegram`
# включает его осознанно и требует заполненных токена и имени бота.
NOTIFICATIONS_TELEGRAM_BOT_TOKEN=
NOTIFICATIONS_TELEGRAM_BOT_USERNAME=
NOTIFICATIONS_TELEGRAM_API_URL=https://api.telegram.org
# Клиент Bot API: http в рабочем окружении, fake — тесты и демо без сети
NOTIFICATIONS_TELEGRAM_CLIENT=http
NOTIFICATIONS_TELEGRAM_TIMEOUT_SECONDS=10
NOTIFICATIONS_TELEGRAM_RETRIES=2
NOTIFICATIONS_TELEGRAM_MESSAGE_LIMIT=4096
NOTIFICATIONS_TELEGRAM_RETRY_AFTER_DEFAULT_SECONDS=30
NOTIFICATIONS_TELEGRAM_LINK_TOKEN_TTL_SECONDS=900
NOTIFICATIONS_TELEGRAM_LINK_TOKEN_RETENTION_DAYS=7
# Режим приёма апдейтов: polling (локально) или webhook (демо, CI)
NOTIFICATIONS_TELEGRAM_UPDATES_MODE=polling
NOTIFICATIONS_TELEGRAM_POLL_TIMEOUT_SECONDS=25
NOTIFICATIONS_TELEGRAM_POLL_BATCH_SIZE=50
NOTIFICATIONS_TELEGRAM_POLL_INTERVAL_SECONDS=1
NOTIFICATIONS_TELEGRAM_WEBHOOK_SECRET=
# Публичный адрес нужен команде notifications:telegram:webhook --set
NOTIFICATIONS_TELEGRAM_WEBHOOK_URL=

# Предпочтения и цепочка замещения M12 (FR-OPS-421, FR-OPS-422, ЧТЗ 8.5).
# Порядок каналов, глубина fallback, критические типы событий и окно тихих
# часов задаются только окружением: литералов в коде нет.
NOTIFICATIONS_PREFERENCES_DEFAULT_TIMEZONE=Europe/Moscow
NOTIFICATIONS_PREFERENCES_CHANNEL_PRIORITY=push,telegram,email
NOTIFICATIONS_PREFERENCES_MAX_FALLBACK_DEPTH=3
NOTIFICATIONS_FALLBACK_ERROR_CODES=TELEGRAM_CHAT_NOT_FOUND,TELEGRAM_REQUEST_REJECTED,NOTIFICATION_CHANNEL_UNAVAILABLE,NOTIFICATION_PROVIDER_REJECTED,NOTIFICATION_DEVICE_UNREGISTERED,NOTIFICATION_PUSH_TOKEN_MISSING
NOTIFICATIONS_CRITICAL_EVENT_TYPES=order.delivered,order.failed
NOTIFICATIONS_QUIET_HOURS_CHANNELS=push,telegram
NOTIFICATIONS_SENDER_EVENT_TYPES=order.created,order.assigned,order.picked_up,order.delivered,order.failed,order.cancelled
NOTIFICATIONS_COURIER_EVENT_TYPES=order.assigned,order.cancelled
NOTIFICATIONS_DISPATCHER_EVENT_TYPES=
NOTIFICATIONS_ADMIN_EVENT_TYPES=
NOTIFICATIONS_PUSH_FAKE_FAIL_RECIPIENTS=

# Пороги состояния сервиса для /health (FR-OPS-204): превышение даёт degraded
NOTIFICATIONS_HEALTH_LAG_THRESHOLD_SECONDS=300
NOTIFICATIONS_HEALTH_PENDING_THRESHOLD=100
