includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8

    paths:
        - app
        - config
        - database
        - routes
        - tests

    excludePaths:
        - bootstrap/cache
        - storage
        - vendor

    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        # В Pest 4 магические методы TestCall ($this->getJson(), artisan())
        # не описаны PHPDoc, поэтому исключение нужно.
        - '#Call to an undefined method Pest\\PendingCalls\\TestCall::.*#'
        # В Pest 4 свойство $not у Expectation<...> не описано типом.
        - '#Access to an undefined property Pest\\Mixins\\Expectation<.*>::\$not#'
