includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8

    paths:
        - app
        - config
        - database
        - routes
        - tests

    excludePaths:
        - bootstrap/cache (?)
        - storage (?)
        - node_modules (?)
        - vendor

    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        # В Pest 4 магические методы TestCall ($this->get(), expect())
        # не описаны PHPDoc, поэтому исключение нужно.
        - '#Call to an undefined method Pest\\PendingCalls\\TestCall::.*#'
