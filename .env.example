APP_NAME="Курьерская служба"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080

# Время и локали приложения берутся из конфигурации (FR-PLT-115)
APP_TIMEZONE=Europe/Moscow
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 16: одна база для разработки; тестовая база courier_testing
# создаётся init-скриптом контейнера (docker/pgsql/init).
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=courier
DB_USERNAME=courier
DB_PASSWORD=courier

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

# predis не требует php-расширения redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# retry_after очереди строго больше --timeout воркера, иначе задача выполнится дважды (FR-OPS-107)
REDIS_QUEUE_RETRY_AFTER=90

# Перехватчик почты Mailpit
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@courier.test"
MAIL_FROM_NAME="${APP_NAME}"

# Транспорт событий (FR-NTF-206): redis — Redis Streams, in-memory — тесты и локальный
# путь M7, rabbitmq зарезервирован под M13. Префикс потоков изолирует окружения на общем Redis.
EVENTS_TRANSPORT=redis
EVENTS_STREAM_PREFIX=
# Имена потоков и параметры потребления (FR-OPS-211, FR-OPS-213)
EVENTS_STREAM_ORDERS=events.orders
EVENTS_STREAM_NOTIFICATIONS=events.notifications
EVENTS_STREAM_CONTACTS=events.contacts
EVENTS_CONSUMER_GROUP=notifications-service
EVENTS_CONSUMER_NAME=notifications-service-1
EVENTS_CONSUME_BATCH_SIZE=50
EVENTS_PENDING_IDLE_SECONDS=60

# Публикатор Outbox (FR-NTF-171, FR-NTF-173): интервал в секундах, размер пачки,
# предел попыток, ряд backoff, TTL блокировки, срок хранения отметок Inbox и пороги outbox:status.
# Laravel повторяет задачу внутри минуты только для 1, 2, 5, 10, 15, 20 и 30 секунд;
# остальные значения округляются вверх до ближайшей поддерживаемой частоты.
EVENTS_PUBLISH_INTERVAL_SECONDS=5
EVENTS_PUBLISH_BATCH_SIZE=100
EVENTS_PUBLISH_MAX_ATTEMPTS=5
EVENTS_PUBLISH_BACKOFF_SECONDS=5,15,60,300,900
EVENTS_PUBLISH_LOCK_TTL_SECONDS=60
# Версия контракта события, попадающая в конверт
EVENTS_SCHEMA_VERSION=v1
# Каталог общих JSON Schema контрактов (FR-NTF-221); путь от корня приложения
EVENTS_SCHEMA_PATH=contracts/notifications
EVENTS_INBOX_RETENTION_DAYS=30
EVENTS_MAX_PUBLISH_LAG_SECONDS=60
EVENTS_MAX_UNPROCESSED_COUNT=0

# Опциональный брокер RabbitMQ (FR-NTF-541…552, ЧТЗ 8.5): значения заведены
# заранее, по умолчанию транспорт остаётся redis, адаптер подключается
# отдельным шагом. Секретов и реальных адресов в репозитории нет (FR-NTF-549).
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_HEARTBEAT=30
RABBITMQ_TIMEOUT_SECONDS=5
RABBITMQ_PREFETCH=50
RABBITMQ_MESSAGE_TTL_SECONDS=300
RABBITMQ_MAX_ATTEMPTS=5
# Публикация идёт в общий exchange; очередь и DLX/DLQ разбирает сервис оповещений
RABBITMQ_EXCHANGE=events
RABBITMQ_DLX_EXCHANGE=events.dlx

# Уведомления: матрица каналов, пределы попыток и сроки хранения живут
# в конфигурации сервиса оповещений — второго отправителя в монолите нет
# (FR-NTF-403, FR-NTF-406).
# Служебный API сервиса для прокси-страниц администратора (ЧТЗ 8.2):
# адрес, сервисный токен, таймаут, число повторов и пауза между ними.
# Токен в репозитории не хранится: значение задаётся окружением.
NOTIFICATIONS_SERVICE_URL=http://notifications-app:8000
NOTIFICATIONS_SERVICE_TOKEN=
NOTIFICATIONS_SERVICE_TIMEOUT_SECONDS=5
NOTIFICATIONS_SERVICE_RETRY_TIMES=1
NOTIFICATIONS_SERVICE_RETRY_SLEEP_MS=100
NOTIFICATIONS_ADMIN_PAGE_SIZE=20

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Ограничение частоты чтения отчётов (FR-RPT-105): запросов в окне и размер окна в секундах
RATE_LIMIT_REPORTS_READ_ATTEMPTS=30
RATE_LIMIT_REPORTS_READ_DECAY=60

# Отчёты (FR-RPT-144, FR-RPT-146, FR-RPT-151, FR-RPT-181…186): валюта отчёта,
# предельная длительность периода в днях, правило периода по умолчанию
# и параметры бенчмарка — размер набора заказов, число замеров, окружения.
REPORTING_CURRENCY=RUB
REPORTING_MAX_PERIOD_DAYS=366
REPORTING_DEFAULT_PERIOD_FROM=start_of_month
REPORTING_DEFAULT_PERIOD_TO=now
REPORTING_BENCHMARK_ORDERS=100000
REPORTING_BENCHMARK_RUNS=20
REPORTING_BENCHMARK_ENVIRONMENTS=local,testing

# Интерфейс (FR-UI-196): название и бренд сервиса, локаль, тема по умолчанию# и имя cookie, домашние страницы ролей, курсорная пагинация, интервал
# автообновления очереди и имена web-маршрутов из писем и публичного трекинга.
UI_NAME="Курьерская служба"
UI_BRAND="Курьер"
UI_LOCALE=ru
UI_THEME_DEFAULT=system
UI_THEME_COOKIE=ui_theme
UI_HOME_SENDER=cabinet.orders
UI_HOME_COURIER=account
UI_HOME_DISPATCHER=dispatcher.queue
UI_HOME_ADMIN=account
UI_PAGINATION_PER_PAGE=20
UI_PAGINATION_MAX=100
UI_DISPATCHER_REFRESH_SECONDS=20
UI_TRACKING_REFRESH_SECONDS=30
UI_TRACKING_PUBLIC_ROUTE=tracking.public.web
UI_EMAIL_VERIFICATION_ROUTE=verification.verify.web
UI_PASSWORD_RESET_ROUTE=password.reset

# Описание API (M10, FR-API-8): включение страницы, путь API, версия схемы
# и зафиксированный файл описания. Маршруты /docs/api существуют только
# в local и testing, поэтому в остальных окружениях переменная ни на что не влияет.
SCRAMBLE_ENABLED=true
SCRAMBLE_PATH=api
SCRAMBLE_VERSION=1.0.0
SCRAMBLE_EXPORT_PATH=docs/api/openapi.json

# Демонстрационные данные (M10): пароль учётных записей и окружения,
# где допустимо наполнение набора. Вне этих окружений сидер отказывает.
DEMO_PASSWORD=password
DEMO_SEED_ENVIRONMENTS=local,testing
